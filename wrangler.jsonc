{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"wujiang-km3",
 "compatibility_date":"2026-09-27",
 "main":"worker/index.js",
 "vars":{"PASSPORT_PRODUCT":"wujiang-km3"},
 "ratelimits":[{"name":"AUTH_LIMIT","namespace_id":"1001","simple":{"limit":30,"period":60}}],
 "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":["/api/auth/*","/api/practice/start","/verify-email","/reset-password"]},
 "routes":[{"pattern":"km3.szlk.uk","custom_domain":true}],
 "workers_dev":false
}
